# Server-only Qwen/DashScope credentials.
# DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
# DASHSCOPE_WORKSPACE_ID=replace-with-your-model-studio-workspace-id
# Optional alias for HTTP translation and notes calls:
# QWEN_API_KEY=replace-with-your-qwen-api-key
# Optional: QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Optional: QWEN_SUMMARY_MODEL=qwen-plus
# Optional: QWEN_MT_MODEL=qwen-mt-plus
# Optional: QWEN_REALTIME_MODEL=qwen3.5-livetranslate-flash-realtime
# Optional: QWEN_REALTIME_REGION=beijing

# Server-only Tencent Cloud realtime speech translation credentials.
# TENCENT_SECRET_ID=replace-with-your-tencent-secret-id
# TENCENT_SECRET_KEY=replace-with-your-tencent-secret-key
# TENCENT_APP_ID=replace-with-your-tencent-app-id
# Optional: TENCENT_TRANSLATION_MODEL=hunyuan-translation-lite
